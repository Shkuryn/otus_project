Процедура ВыгрузкаОстатковБонусов() Экспорт
	Данные = ДанныеДляПодключенияКролика();	
	Данные.Вставить("ИмяОчереди", "balances");
	Данные.Вставить("Ключ", "bl");
	
	ПодключитьВнешнююКомпоненту("ОбщийМакет.PinkRabbitMQ", "BITERP", ТипВнешнейКомпоненты.Native);
	Клиент  = Новый("AddIn.BITERP.PinkRabbitMQ");
	
	Клиент.Connect(
	Данные.ИмяХоста,
	Данные.Порт,
	Данные.Логин,
	Данные.Пароль,
	Данные.ВиртуальныйХост);
	
	ИмяОчереди = Данные.ИмяОчереди;
	ТочкаОбмена = Данные.ИмяТочкиОбмена;
	
	АктуальныеОстатки = ОстаткиБонусов();
	
	Для Каждого Остаток Из АктуальностьДанных Цикл
	ДанныеJSON = Новый Структура;
	ДанныеJSON.Вставить("cardNumber", Остаток.КодКарты);
	ДанныеJSON.Вставить("amount", Остаток.КолБонусов);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеJSON);
	ТекстСообщения = ЗаписьJSON.Закрыть();	
	
	Попытка	
	
		Клиент.BasicPublish(
			ТочкаОбмена,     // exchange
			Данные.Ключ,     // routingKey - тот ключ, по которому настроена привязка
			ТекстСообщения,  // message
			0,               // livingTime
			Ложь             // persist
		);
		
		ЗаписьЖурналаРегистрации("Выгрузка остатков бонусов", , , , 
			"Сообщение успешно отправлено в exchange: " + ТочкаОбмена + " с ключом: bl");
		
	Исключение
		ТекстОшибки = "Выгрузка остатков бонусов завершилась с ошибкой: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Выгрузка остатков бонусов", , , , ТекстОшибки, УровеньЖурналаРегистрации.Ошибка);
	КонецПопытки;	  
	КонецЦикла;
КонецПроцедуры

Процедура ВыгрузкаЗаявокНаВывод() Экспорт
	Данные = ДанныеДляПодключенияКролика();	
	Данные.Вставить("ИмяОчереди", "accepted_output");
	Данные.Вставить("Ключ", "ou");
	
	ПодключитьВнешнююКомпоненту("ОбщийМакет.PinkRabbitMQ", "BITERP", ТипВнешнейКомпоненты.Native);
	Клиент  = Новый("AddIn.BITERP.PinkRabbitMQ");
	
	Клиент.Connect(
	Данные.ИмяХоста,
	Данные.Порт,
	Данные.Логин,
	Данные.Пароль,
	Данные.ВиртуальныйХост);
	
	ИмяОчереди = Данные.ИмяОчереди;
	ТочкаОбмена = Данные.ИмяТочкиОбмена;

    Узел = ПланыОбмена.Мобильные.НайтиПоКоду("002");
	Заявки = ЗаявкиНаВывод(Узел);   
		
	Для Каждого Заявка Из Заявки Цикл 
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(); 
	ДанныеJSON = Новый Структура;
	ДанныеJSON.Вставить("cardNumber", Заявка.КодКарты);
	ДанныеJSON.Вставить("amount", Заявка.КолБонусов);	
	ЗаписатьJSON(ЗаписьJSON, ДанныеJSON);
	ТекстСообщения = ЗаписьJSON.Закрыть();	
	
	Попытка	
		Клиент.BasicPublish(
			ТочкаОбмена,     // exchange
			Данные.Ключ,     // routingKey - тот ключ, по которому настроена привязка
			ТекстСообщения,  // message
			0,               // livingTime
			Ложь             // persist
		);
		
	ЗаписьЖурналаРегистрации("Выгрузка остатков бонусов", , , , 
			"Сообщение успешно отправлено в exchange: " + ТочкаОбмена + " с ключом: bl"); 
	Ссылка = Документы.СписаниеБонусов.ПолучитьСсылку(Заявка.ИД);
	ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Ссылка);	
	Исключение
		ТекстОшибки = "Выгрузка остатков бонусов завершилась с ошибкой: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Выгрузка остатков бонусов", , , , ТекстОшибки, УровеньЖурналаРегистрации.Ошибка);
	КонецПопытки;
	
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс
// Код процедур и функций
