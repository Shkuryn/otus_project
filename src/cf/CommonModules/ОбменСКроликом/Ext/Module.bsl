#Область СлужебныеПроцедурыИФункции

Функция ДанныеДляПодключенияКролика()
	Данные = Новый Структура;
	Данные.Вставить("ИмяХоста", "localhost");
	Данные.Вставить("Порт", 5672);
	Данные.Вставить("Логин", "guest");
	Данные.Вставить("Пароль", "guest");
	Данные.Вставить("ВиртуальныйХост", "otus");
	Данные.Вставить("ИмяТочкиОбмена", "discount_cards");
	
	Возврат Данные;
КонецФункции             

Процедура ОбработкаДанныхДисконтныхКарт(ОтветноеСообщение)
	РеквизитыКонтрагента = СтрокуJSONВСтруктуру(ОтветноеСообщение);      
	Контрагент = КонтрагентПоРеквизитам(РеквизитыКонтрагента);
	СоздатьДисконтнуюКарту(Контрагент);
КонецПроцедуры  

Процедура ОбработкаЗаявокНаВывод(ОтветноеСообщение)
	РеквизитыЗаявки = СтрокуJSONВСтруктуру(ОтветноеСообщение);  
	СоздатьЗаявкуНаВывод(РеквизитыЗаявки);  
КонецПроцедуры                                                  

Функция СтрокуJSONВСтруктуру(Значение)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Значение);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	Возврат Результат;
КонецФункции  

Функция КонтрагентПоРеквизитам(Реквизиты)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Контрагенты.Телефон КАК Телефон,
	|	Контрагенты.Наименование КАК Наименование,
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Телефон = &Телефон
	|	И Контрагенты.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Телефон", Реквизиты.phoneNumber);
	Запрос.УстановитьПараметр("Наименование", СтрШаблон("%1 %2 %3", Реквизиты.surname, Реквизиты.name, Реквизиты.middleName));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		
		Возврат НовыйКонтрагент(Реквизиты);
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции

Функция НовыйКонтрагент(Реквизиты)
	НовКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
	НовКонтрагент.Наименование = СтрШаблон("%1 %2 %3", Реквизиты.surname, Реквизиты.name, Реквизиты.middleName);
	НовКонтрагент.Телефон = Реквизиты.phoneNumber;
	НовКонтрагент.ОбменДанными.Загрузка = Истина;
	НовКонтрагент.Записать();
	
	Возврат НовКонтрагент.Ссылка;
КонецФункции    

Процедура СоздатьДисконтнуюКарту(Контрагент)  
	ДК = Справочники.ДисконтныеКарты.СоздатьЭлемент(); 
	ДК.УстановитьНовыйКод();
	ДК.ОбменДанными.Загрузка = Истина;
	ДК.Владелец = Контрагент;
	ДК.Записать();
КонецПроцедуры    

Процедура СоздатьЗаявкуНаВывод(РеквизитыЗаявки)
	ДискотнаяКарта = Справочники.ДисконтныеКарты.НайтиПоКоду(РеквизитыЗаявки.cardNumber);
	Если ДискотнаяКарта.Пустая() Тогда 
		ТекстСообщения = СтрШаблон( "Не найдена карта с номером %1", РеквизитыЗаявки.cardNumber);
		ЗаписьЖурналаРегистрации("Загрузка заявок",, ,,ТекстСообщения); 
		Возврат;
	КонецЕсли;
	
	ДокСписание = Документы.СписаниеБонусов.СоздатьДокумент();     
	ДокСписание.Дата = ТекущаяДатаСеанса();
	ДокСписание.ДисконтнаяКарта = ДискотнаяКарта;
	ДокСписание.Бонусов = РеквизитыЗаявки.amount;
	ДокСписание.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры 

Функция ЗаявкиНаВывод(Узел)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СписаниеБонусовИзменения.Ссылка КАК Ссылка,
	               |	СписаниеБонусовИзменения.Ссылка.ДисконтнаяКарта.Код КАК КодКарты,
	               |	СписаниеБонусовИзменения.Ссылка.Бонусов КАК КолБонусов
	               |ИЗ
	               |	Документ.СписаниеБонусов.Изменения КАК СписаниеБонусовИзменения
	               |ГДЕ
	               |	СписаниеБонусовИзменения.Ссылка.Проведен
	               |	И НЕ СписаниеБонусовИзменения.Ссылка.Выгружен
	               |	И СписаниеБонусовИзменения.Узел = &Узел";      
	
	Запрос.УстановитьПараметр("Узел", Узел);
	Результат = Запрос.Выполнить();
	Заявки = Новый Массив();
	Если Не Результат.Пустой() Тогда 
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл 
			Структура = Новый Структура;
			Структура.Вставить("КодКарты", Выборка.КодКарты);
			Структура.Вставить("КолБонусов", Выборка.КолБонусов);
			Структура.Вставить("ИД", Выборка.Ссылка.УникальныйИдентификатор());
			Заявки.Добавить(Структура);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Заявки;
КонецФункции

Функция ОстаткиБонусов()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	БонусыОстатки.ДисконтнаяКарта.Код КАК КодКарты,
	               |	БонусыОстатки.СуммаОстаток КАК КолБонусов
	               |ИЗ
	               |	РегистрНакопления.Бонусы.Остатки(, ) КАК БонусыОстатки
	               |ГДЕ
	               |	НЕ БонусыОстатки.ДисконтнаяКарта.Неактивна";      
	
	
	Результат = Запрос.Выполнить();
	Остатки = Новый Массив();
	Если Не Результат.Пустой() Тогда 
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл 
			Структура = Новый Структура;
			Структура.Вставить("КодКарты", Выборка.КодКарты);
			Структура.Вставить("КолБонусов", Выборка.КолБонусов);
			Остатки.Добавить(Структура);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Остатки;
	
КонецФункции


#КонецОбласти