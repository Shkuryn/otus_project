Процедура ЗагрузкаДисконтныхКарт() Экспорт
	Данные = ДанныеДляПодключенияКролика();	
	Данные.Вставить("ИмяОчереди", "discount_cards_from_mobile");
	
	ПодключитьВнешнююКомпоненту("ОбщийМакет.PinkRabbitMQ", "BITERP", ТипВнешнейКомпоненты.Native);
	Клиент  = Новый("AddIn.BITERP.PinkRabbitMQ");
	Попытка
		Клиент.Connect(
		Данные.ИмяХоста,
		Данные.Порт,
		Данные.Логин,
		Данные.Пароль,
		Данные.ВиртуальныйХост);
		
		
		ИмяОчереди = Данные.ИмяОчереди;
		
		Попытка
			Потребитель = Клиент.BasicConsume(ИмяОчереди, "", Истина, Ложь, 0);
			ОтветноеСообщение = "";
			Если Клиент.BasicConsumeMessage("", ОтветноеСообщение, 5) Тогда
				Клиент.BasicAck(); 
				ОбработкаДанныхДисконтныхКарт(ОтветноеСообщение);
			Иначе
			КонецЕсли;
			Клиент.BasicCancel("");
		Исключение
			ВызватьИсключение Клиент.GetLastError();
		КонецПопытки;
	Исключение
		СистемнаяОшибка = ОписаниеОшибки();
		ТекстСообщения = "Ошибка чтения сообщения!%СистемнаяОшибка%";
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%СистемнаяОшибка%", СистемнаяОшибка);
		ВызватьИсключение ТекстСообщения;
	КонецПопытки;
	
КонецПроцедуры

